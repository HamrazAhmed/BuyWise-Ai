# Environment variable names for BuyWise AI
# Copy this file to .env (gitignored) and fill in the values.
# NEVER commit .env or any file containing real secrets.

# --- Backend (persistent FastAPI and worker) ---

# Backend mode: auto (legacy key/demo selection), demo (canned), fixture (no network), gemini (key required).
# To test P2 with an existing key, launch with BUYWISE_MODE=fixture; .env need not change.
BUYWISE_MODE=auto

# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Current SDK adapter uses explicit-key clients; availability depends on your project.
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_STRONG_MODEL=gemini-3.1-flash-lite
# 768-dimensional text retrieval. Changing embedding models requires reindexing.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Per-key UTC daily outbound-attempt cap; shared with DATABASE_URL, local otherwise.
GEMINI_DAILY_CALL_LIMIT=100
GEMINI_CONCURRENCY=3
GEMINI_TIMEOUT_SECONDS=12

# Supabase Postgres connection string (includes password)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=

# Pakistan/PKR is the approved source catalog. US retains the older undated seed path.
BUYWISE_MARKET=PK
# Attempt bounded, robots-aware refresh. Blocked pages retain stale/undated snapshots.
BUYWISE_SOURCE_REFRESH=true
# Local dev starts a tracked worker inside FastAPI. Production: false + separate worker.
BUYWISE_INLINE_WORKER=true
# Local SQLite runtime path, used only when DATABASE_URL is empty.
# BUYWISE_DB=.local/runtime.sqlite3

# Reserved; no search API integration. Approved catalog is the bounded fallback.
SEARCH_API_KEY=

# Origin that the FastAPI backend allows for CORS (your Vercel frontend URL)
# Local dev: http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---

# Set to "true" to use mock data (no backend required).
# Set to "false" to call the real FastAPI backend.
NEXT_PUBLIC_USE_MOCKS=false

# Base URL for the FastAPI backend (used when NEXT_PUBLIC_USE_MOCKS=false)
# Local dev: http://localhost:8000
# Production: your dedicated backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Legacy fixture path override; BUYWISE_DB takes precedence. Default: .local/runtime.sqlite3.
# BUYWISE_FIXTURE_DB=
