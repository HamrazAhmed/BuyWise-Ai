# Environment variable names for BuyWise AI
# Copy this file to .env (gitignored) and fill in the values.
# NEVER commit .env or any file containing real secrets.

# --- Backend (FastAPI / Vercel Python functions) ---

# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Supabase Postgres connection string (includes password)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=

# Free search/product data API key (e.g., SerpApi, Brave Search, etc.) [VERIFY which to use]
SEARCH_API_KEY=

# Origin that the FastAPI backend allows for CORS (your Vercel frontend URL)
# Local dev: http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---

# Set to "true" to use mock data (no backend required).
# Set to "false" to call the real FastAPI backend.
NEXT_PUBLIC_USE_MOCKS=true

# Base URL for the FastAPI backend (used when NEXT_PUBLIC_USE_MOCKS=false)
# Local dev: http://localhost:8000
# Production: your Vercel deployment URL or dedicated backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
